# This repository tracks only the BSK -> UE renderer. Other experiments that
# happen to live beside it in this workspace are intentionally excluded.
/Isaac/
/basilisk/
/demo_outputs/
/learning_mjscene/
/output/
/simple_rl_code/
/spacemind/
/space_sim/
/tmp/
/run_vizard_demo.ps1
/*.log

# Keep the redistributable model fixtures required by the runnable demos;
# ignore other local tests.
/test/*
!/test/model/
/test/model/*
!/test/model/arm/
/test/model/arm/*
!/test/model/arm/universal_robots_ur5e/
!/test/model/arm/universal_robots_ur5e/**
!/test/model/spacecraft_and_arm/
!/test/model/spacecraft_and_arm/**

# Unreal Engine generated state.
**/.vs/
**/Binaries/
**/DerivedDataCache/
**/Intermediate/
**/Saved/
**/Dist/
**/Plugins/*/Binaries/
**/Plugins/*/Intermediate/
**/Content/Developers/
**/Content/Collections/
# Generated from the externally supplied CubeSat + SO-101 STL model.  Rebuild
# locally with scripts/prepare_spacecraft_arm_assets.ps1.
**/Content/BSK/Generated/CubeSatSO101/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Python and test caches.
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
.venv/
venv/

# Editors and operating systems.
.idea/
.vscode/
*.user
*.userprefs
.DS_Store
Thumbs.db

# Textures.com PBR0110 is account-licensed, not a redistributable CC0 asset.
/Unreal/BskUnrealRenderer/ContentSource/PBR0110/maps/
/Unreal/BskUnrealRenderer/Content/BSK/Materials/PBR0110/
/Unreal/BskUnrealRenderer/Content/BSK/VisualOverlays/SarmMLI_PBR0110/
# Continuous wrap geometry is regenerated from the fitting recipe.
/Unreal/BskUnrealRenderer/ContentSource/PBR0110/Continuous/*.obj
/Unreal/BskUnrealRenderer/ContentSource/PBR0110/Continuous/*.mtl
/Unreal/BskUnrealRenderer/Samples/PixelStreaming2/WebServers/
